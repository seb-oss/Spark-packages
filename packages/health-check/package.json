{
  "name": "@sebspark/health-check",
  "version": "3.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest run --config ../../vitest.e2e.config.mts --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@sebspark/hyper-media": "0.1.8",
    "@sebspark/promise-cache": "8.1.10",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@google-cloud/pubsub": "6.4.1",
    "@sebspark/tsconfig": "3.0.30",
    "@testcontainers/gcloud": "12.2.1",
    "@testcontainers/mockserver": "12.2.1",
    "@testcontainers/redis": "12.2.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

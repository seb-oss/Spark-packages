{
  "name": "@sebspark/typed-router",
  "version": "2.0.9",
  "private": true,
  "license": "Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "express": "5.3.0"
  },
  "keywords": [
    "express",
    "middleware",
    "router",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sebspark/tsconfig": "*",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

{
  "name": "@sebspark/openapi-typegen",
  "version": "5.3.4",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": "./cli.mjs",
  "files": [
    "dist",
    "cli.mjs"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sebspark/tsconfig": "3.0.30",
    "@types/yargs": "17.0.35",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@sebspark/openapi-core": "4.1.27",
    "boxen": "9.0.0",
    "chalk": "6.0.1",
    "change-case": "5.4.4",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "yargs": "18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

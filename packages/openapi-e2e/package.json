{
  "name": "@sebspark/openapi-e2e",
  "version": "4.0.63",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "yarn openapi-typegen -i ./src/schemas/ -o ./src/schemas/",
    "lint": "biome check --write .",
    "test": "yarn generate && vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "yarn generate && tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run"
  },
  "dependencies": {
    "@sebspark/openapi-client": "4.2.25",
    "@sebspark/openapi-core": "4.1.26",
    "@sebspark/openapi-express": "5.4.23",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sebspark/openapi-typegen": "5.3.3",
    "@types/express": "5.0.6",
    "find-free-ports": "3.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

    "express": "5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sebspark/openapi-typegen": "5.3.1",
    "@types/express": "5.0.6",
    "depcheck": "1.4.7",
    "find-free-ports": "3.1.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }

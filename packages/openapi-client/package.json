{
  "name": "@sebspark/openapi-client",
  "version": "4.2.21",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "yarn openapi-typegen -i ./src/__tests__/ -o ./src/__tests__/",
    "build": "spark-build src/index.ts",
    "depcheck": "depcheck",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage",
    "pretest": "yarn generate",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@sebspark/openapi-typegen": "5.2.5",
    "@sebspark/tsconfig": "*",
    "depcheck": "1.4.7",
    "express": "5.2.1",
    "nock": "14.0.17",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@sebspark/openapi-core": "4.1.23",
    "@sebspark/otel": "4.1.17",
    "@sebspark/retry": "1.0.20",
    "axios": "1.20.0",
    "axios-auth-refresh": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

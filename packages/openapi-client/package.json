{
  "name": "@sebspark/openapi-client",
  "version": "4.2.31",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "yarn openapi-typegen -i ./src/__tests__/ -o ./src/__tests__/",
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "yarn generate && vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "yarn generate && tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@sebspark/openapi-typegen": "5.3.4",
    "@sebspark/tsconfig": "3.0.30",
    "express": "5.3.0",
    "find-free-ports": "3.1.1",
    "nock": "15.0.6",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@sebspark/openapi-core": "4.1.27",
    "@sebspark/otel": "5.0.1",
    "@sebspark/retry": "1.0.21",
    "axios": "1.21.1",
    "axios-auth-refresh": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

{
  "name": "@sebspark/openapi-client",
  "version": "4.2.22",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "yarn openapi-typegen -i ./src/__tests__/ -o ./src/__tests__/",
    "build": "spark-build src/index.ts",
    "depcheck": "depcheck",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "pretest": "yarn generate",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sebspark/openapi-typegen": "5.3.1",
    "@sebspark/tsconfig": "3.0.26",
    "depcheck": "1.4.7",
    "express": "5.3.0",
    "nock": "15.0.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@sebspark/openapi-core": "4.1.24",
    "@sebspark/otel": "4.2.0",
    "@sebspark/retry": "1.0.20",
    "axios": "1.20.0",
    "axios-auth-refresh": "5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

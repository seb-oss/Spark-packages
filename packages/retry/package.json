{
  "name": "@sebspark/retry",
  "version": "1.0.18",
  "license": "Apache-2.0",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts --format=esm --format=cjs",
    "dev": "tsc --watch --noEmit",
    "lint": "biome lint .",
    "test": "vitest run --passWithNoTests --coverage",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@sebspark/tsconfig": "*",
    "axios": "1.20.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

{
  "name": "@sebspark/cli-tester",
  "version": "1.0.21",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "dependencies": {
    "@inquirer/figures": "2.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@inquirer/prompts": "8.7.4",
    "@sebspark/tsconfig": "3.0.27",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

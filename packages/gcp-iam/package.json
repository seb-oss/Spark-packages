  },
  "dependencies": {
    "@google-cloud/iam-credentials": "5.1.0",
    "@sebspark/otel": "5.0.0",
    "google-auth-library": "11.3.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sebspark/tsconfig": "3.0.29",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}

{
  "name": "@sebspark/socket.io-gcp-pubsub-emitter",
  "version": "1.0.34",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@sebspark/tsconfig": "3.0.30",
    "@socket.io/gcp-pubsub-adapter": "0.1.1",
    "@testcontainers/gcloud": "12.2.1",
    "find-free-ports": "3.1.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@google-cloud/pubsub": "6.4.1",
    "@msgpack/msgpack": "3.1.3",
    "socket.io-adapter": "2.5.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

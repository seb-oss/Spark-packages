{
  "name": "@sebspark/spanner-migrate",
  "version": "2.1.6",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "@sebspark/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": "./dist/cli.mjs",
  "scripts": {
    "build": "spark-build src/index.ts src/cli.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@google-cloud/spanner": "9.1.1",
    "@sebspark/cli-tester": "1.0.26",
    "@sebspark/tsconfig": "3.0.31",
    "@types/yargs": "17.0.35",
    "testcontainers": "12.2.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@google-cloud/spanner": "9.1.1",
    "@inquirer/prompts": "8.8.1",
    "typescript": "7.0.2",
    "yargs": "18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

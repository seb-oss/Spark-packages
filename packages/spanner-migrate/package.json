{
  "name": "@sebspark/spanner-migrate",
  "version": "2.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "bin": "./dist/cli.mjs",
  "scripts": {
    "build": "spark-build src/index.ts src/cli.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit "
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@google-cloud/spanner": "9.1.0",
    "@sebspark/cli-tester": "1.0.21",
    "@sebspark/tsconfig": "3.0.27",
    "@types/yargs": "17.0.35",
    "testcontainers": "12.2.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@google-cloud/spanner": "9.1.0",
    "@inquirer/prompts": "8.7.5",
    "typescript": "7.0.2",
    "yargs": "18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

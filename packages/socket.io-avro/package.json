{
  "name": "@sebspark/socket.io-avro",
  "version": "0.1.23",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./parser": {
      "types": "./dist/parser.d.mts",
      "react-native": "./dist/parser.mjs",
      "import": "./dist/parser.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "react-native": "./dist/client.mjs",
      "import": "./dist/client.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/parser.ts src/server.ts src/client.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "dependencies": {
    "@sebspark/avsc-isometric": "0.4.16",
    "socket.io-parser": "4.2.7"
  },
  "peerDependencies": {
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@sebspark/tsconfig": "*",
    "find-free-ports": "3.1.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

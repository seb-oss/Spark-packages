{
  "name": "@sebspark/opentelemetry-instrumentation-opensearch",
  "version": "0.3.15",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "vitest --typecheck.only --passWithNoTests --run"
  },
  "peerDependencies": {
    "@opensearch-project/opensearch": ">=2",
    "@opentelemetry/api": ">=1.10.0 <1.11.0"
  },
  "dependencies": {
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@opensearch-project/opensearch": "3.9.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@sebspark/tsconfig": "3.0.25",
    "@testcontainers/opensearch": "12.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

{
  "name": "@sebspark/otel",
  "version": "5.0.4",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "@sebspark/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "test:e2e": "vitest --config vitest.config.e2e.ts --run --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-dns": "0.68.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-fs": "0.44.0",
    "@opentelemetry/instrumentation-grpc": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-net": "0.69.0",
    "@opentelemetry/instrumentation-redis": "0.73.0",
    "@opentelemetry/instrumentation-socket.io": "0.72.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resource-detector-container": "0.9.1",
    "@opentelemetry/resource-detector-gcp": "0.60.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "fast-safe-stringify": "2.1.1",
    "kleur": "4.1.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@opensearch-project/opensearch": ">=2",
    "@sebspark/opentelemetry-instrumentation-opensearch": "^0.4.5"
  },
  "peerDependenciesMeta": {
    "@opensearch-project/opensearch": {
      "optional": true
    },
    "@sebspark/opentelemetry-instrumentation-opensearch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@opensearch-project/opensearch": "3.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@sebspark/opentelemetry-instrumentation-opensearch": "0.4.5",
    "@sebspark/tsconfig": "3.0.31",
    "@testcontainers/opensearch": "12.2.2",
    "@testcontainers/redis": "12.2.2",
    "axios": "1.21.1",
    "express": "5.3.0",
    "find-free-ports": "3.1.1",
    "redis": "6.4.0",
    "typescript": "7.0.2",
    "undici": "8.13.1",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

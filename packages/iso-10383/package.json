{
  "name": "@sebspark/iso-10383",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache",
    "generate": "node scripts/parseMicCsv.mjs src/lib/specifications/iso10383.csv src/lib/generated/iso10383.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sebspark/tsconfig": "3.0.29",
    "change-case": "5.4.4",
    "csv-parse": "7.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "keywords": [
    "Financial",
    "Financial Instruments",
    "ISO",
    "ISO 10383",
    "Market Identifier Codes",
    "MIC",
    "Securities"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}

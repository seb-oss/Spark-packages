{
  "$schema": "https://v2-11-13.turborepo.dev/schema.json",
  "concurrency": "100%",
  "cacheMaxAge": "14d",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false
    },
    "generate:avro": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "//#test:tools:plain": {
      "inputs": [
        "tools/**",
        ".husky/**",
        "turbo/generators/**",
        "packages/**",
        "!packages/*/node_modules/**",
        "!packages/*/.turbo/**",
        "!packages/*/coverage/**",
        "!packages/*/dist/**",
        "!packages/*/build/**",
        "!**/.DS_Store",
        "package.json",
        "turbo.json",
        "README.md",
        "yarn.lock",
        ".nvmrc"
      ],
      "outputs": []
    },
    "//#test:tools:color": {
      "inputs": [
        "tools/**",
        ".husky/**",
        "turbo/generators/**",
        "packages/**",
        "!packages/*/node_modules/**",
        "!packages/*/.turbo/**",
        "!packages/*/coverage/**",
        "!packages/*/dist/**",
        "!packages/*/build/**",
        "!**/.DS_Store",
        "package.json",
        "turbo.json",
        "README.md",
        "yarn.lock",
        ".nvmrc"
      ],
      "outputs": []
    },
    "//#security-scan:raw": {
      "inputs": [
        "packages/**/src/**",
        "tools/**",
        "package.json",
        "!**/dist/**",
        "!**/node_modules/**"
      ],
      "outputs": []
    }
  }
}

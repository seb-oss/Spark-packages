{
  "name": "sebspark",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "check-upgrades": "node ./tools/check-upgrades.mjs && yarn upgrade-interactive",
    "clean": "rm -rf ./packages/**/dist",
    "depcheck": "turbo depcheck",
    "dev": "turbo dev",
    "format": "biome format --write",
    "generate:avro": "turbo generate:avro",
    "generate:package": "turbo gen package",
    "lint:watch": "turbo watch lint",
    "lint:write": "biome check --write",
    "knip": "knip",
    "lint": "node ./tools/check-no-dist-imports.mjs && turbo lint",
    "release": "turbo build && npx changeset publish",
    "security-scan": "turbo run security-scan:raw --filter=//",
    "security-scan:raw": "docker run --rm -v \"$PWD:/src\" semgrep/semgrep semgrep scan --error --config p/security-audit --config p/javascript --config p/typescript",
    "smoketest": "yarn syncpack && yarn depcheck && yarn format && yarn lint && yarn build && yarn depcheck && yarn test && yarn security-scan",
    "start": "turbo watch lint test typecheck",
    "syncpack": "syncpack lint",
    "test:watch": "turbo watch test",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:watch": "turbo watch test:e2e",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version && yarn install --no-immutable",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@changesets/cli": "3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@sebspark/tsconfig": "3.0.25",
    "@turbo/gen": "2.11.10",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "depcheck": "1.4.7",
    "husky": "9.1.7",
    "knip": "6.43.0",
    "syncpack": "15.3.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependenciesMeta": {
    "bufferutil@4.0.9": {
      "built": false
    },
    "cpu-features@0.0.10": {
      "built": false
    },
    "utf-8-validate@5.0.10": {
      "built": false
    }
  },
  "resolutions": {
    "@babel/core": "7.29.7",
    "uuid@^9.0.0": "14.0.3",
    "uuid@^9.0.1": "14.0.3",
    "ws": "8.22.0"
  },
  "workspaces": [
    "packages/*",
    "!packages/logging",
    "!packages/typed-router"
  ],
  "packageManager": "yarn@4.18.0"
}

{
  "name": "sebspark",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "clean": "rm -rf ./packages/**/dist",
    "dev": "turbo dev",
    "format": "biome format --write",
    "generate:avro": "turbo generate:avro",
    "generate:package": "turbo gen package",
    "lint:watch": "turbo watch lint",
    "knip": "knip",
    "lint": "node ./tools/check-no-dist-imports.mjs && turbo lint",
    "lint:ci": "node ./tools/check-no-dist-imports.mjs && biome ci --error-on-warnings",
    "release": "turbo build && npx changeset publish",
    "security-scan": "turbo run security-scan:raw --filter=//",
    "security-scan:raw": "docker run --rm -v \"$PWD:/src\" semgrep/semgrep:1.182.1@sha256:451b3d875c00dac7ed5db5293e584a07de11449a409c10b3c2d2652f429630b6 semgrep scan --error --config p/security-audit --config p/javascript --config p/typescript",
    "smoketest": "yarn syncpack && yarn knip && yarn format && yarn lint:ci && yarn build && yarn typecheck && node tools/check-licenses.mjs && yarn test && yarn test:tools && yarn security-scan",
    "start": "turbo watch lint test typecheck",
    "syncpack": "syncpack lint",
    "test:watch": "turbo watch test",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "test:e2e:watch": "turbo watch test:e2e",
    "test:tools": "node --test tools/",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version && yarn install --no-immutable",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@changesets/cli": "3.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@sebspark/tsconfig": "3.0.29",
    "@turbo/gen": "2.11.10",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "syncpack": "15.3.3",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependenciesMeta": {
    "bufferutil@4.0.9": {
      "built": false
    },
    "cpu-features@0.0.10": {
      "built": false
    },
    "utf-8-validate@5.0.10": {
      "built": false
    }
  },
  "resolutions": {
    "@babel/core": "7.29.7",
    "engine.io-client/ws": "8.22.1",
    "glob": "14.0.3",
    "readdir-glob/minimatch": "11.0.3",
    "uuid@^9.0.0": "14.0.3",
    "uuid@^9.0.1": "14.0.3"
  },
  "workspaces": [
    "packages/*",
    "!packages/logging",
    "!packages/pubsub",
    "!packages/typed-router"
  ],
  "packageManager": "yarn@4.18.0"
}

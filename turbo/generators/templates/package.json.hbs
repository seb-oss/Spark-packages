{
  "name": "@sebspark/{{name}}",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "@sebspark/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "spark-build src/index.ts",
    "dev": "tsc --watch --noEmit",
    "lint": "biome check --write .",
    "test": "vitest run --passWithNoTests --coverage --fsModuleCachePath node_modules/.vitest-cache",
    "typecheck": "tsc --noEmit -p . && vitest --typecheck.only --passWithNoTests --run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "devDependencies": {
    "@biomejs/biome": "{{rootVersion '@biomejs/biome'}}",
    "@sebspark/tsconfig": "{{rootVersion '@sebspark/tsconfig'}}",
    "typescript": "{{rootVersion 'typescript'}}",
    "vite": "{{rootVersion 'vite'}}",
    "vitest": "{{rootVersion 'vitest'}}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seb-oss/Spark-packages.git"
  }
}
